# ─────────────────────────────────────────────────────────────────────────────
# PaddelStats — Variables de entorno del servidor
# Copia este fichero como .env y rellena los valores reales.
# NUNCA subas .env a git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage ───────────────────────────────────────────────────────────────────
# "local"  → guarda vídeos en /app/uploaded_videos (volumen Docker)
# "s3"     → usa S3-compatible (Crusoe Object Storage, Cloudflare R2, AWS S3)
STORAGE_BACKEND=local

# Solo necesario si STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://s3.rcs-tls.crusoecloud.com   # Crusoe Object Storage endpoint
S3_BUCKET=paddelstats
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ── Base de datos ─────────────────────────────────────────────────────────────
# SQLite local (dev/staging)
DATABASE_URL=sqlite:///./paddelstats.db
# PostgreSQL en producción (Cloud SQL, Supabase, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/paddelstats

# ── GPU ───────────────────────────────────────────────────────────────────────
# "cuda" en servidor NVIDIA, "mps" en Mac, "cpu" como fallback
TORCH_DEVICE=cuda
